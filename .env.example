# Copia questo file in .env (che non va committato) e adatta i valori.

# "true" = dati finti nel browser (Faker + localStorage), nessun backend necessario.
# In produzione con un backend reale DEVE essere "false": con "true" il login
# accetta le credenziali di prova e i dati restano solo nel browser.
VITE_MOCKING=true

# Indirizzo del backend (vuoto = stessa origine; in sviluppo /api passa dal proxy di Vite verso localhost:8080)
VITE_API_URL=

# Dominio della piattaforma (es. ristosagra.it): lì landing, registrazione e accesso, ogni sagra
# sul suo sottodominio (pesce.ristosagra.it). Vuoto = una sola sagra, l'app come prima della
# piattaforma (deploy pilota, demo). In sviluppo "localhost": localhost:5199 è la landing,
# <nome>.localhost:5199 una sagra (Chrome e Firefox risolvono *.localhost da soli)
VITE_ROOT_DOMAIN=

# Indirizzo della demo con i dati finti (es. https://demo.ristosagra.it), linkata dalla landing.
# Vuoto = il bottone "Prova la demo" non compare
VITE_DEMO_URL=
